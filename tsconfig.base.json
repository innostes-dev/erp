{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@business-os/source"],
    "paths": {
      "@business-os/core": ["packages/core/src/index.ts"],
      "@business-os/audit-logger": ["packages/audit-logger/src/index.ts"],
      "@luxis-ui/react": ["@luxis-ui/react/src/index.ts"],
      "@core": ["packages/core/src/index.ts"],
      "@core/*": ["packages/core/src/*"]
    }
  }
}

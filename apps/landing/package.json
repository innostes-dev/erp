{
  "name": "@innostes/landing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-demo-registry.mjs && next dev --port 3000",
    "build": "node scripts/generate-demo-registry.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "node scripts/generate-demo-registry.mjs && next typegen && tsc --noEmit",
    "demos": "node scripts/generate-demo-registry.mjs"
  },
  "nx": {
    "name": "landing",
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      },
      "start": {
        "dependsOn": [
          "build"
        ],
        "continuous": true
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/.next"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "dependencies": {
    "@innostes/ui": "workspace:*",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31"
  }
}

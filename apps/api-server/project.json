{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api-server/app",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-server",
        "commands": [
          "(which uv >/dev/null 2>&1 && uv venv .venv && uv pip install -r requirements.txt --python .venv/bin/python) || (python3 -m venv .venv || python -m venv .venv; (test -f .venv/bin/pip && .venv/bin/pip install -r requirements.txt) || (.venv/Scripts/python -m pip install -r requirements.txt))"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-server",
        "command": "node serve.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-server",
        "command": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'"
      }
    }
  }
}

{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api-server/app",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-server",
        "commands": [
          "python3 -m venv .venv || python -m venv .venv",
          "(test -f .venv/bin/pip && .venv/bin/pip install -r requirements.txt) || (.venv/Scripts/python -m pip install -r requirements.txt)"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-server",
        "command": "(test -f .venv/bin/python && .venv/bin/python -m fastapi dev app/main.py --port 8000) || (.venv/Scripts/python -m fastapi dev app/main.py --port 8000)"
      }
    }
  }
}

# ==========================================
# Innostes ERP API Server Configuration
# ==========================================

# Application Settings
APP_NAME="Innostes ERP API"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Enterprise PostgreSQL Configuration
# Option A: Connection URI (takes precedence if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_dev

# Option B: Individual connection parameters (fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_dev
DB_SCHEMA=public
DB_SSL_MODE=prefer

# Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

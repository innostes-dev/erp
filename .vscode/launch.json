{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (api-server)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--app-dir",
        "apps/api-server",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/apps/api-server/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/api-server",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Backend: Debug Current Test File",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["${file}"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/apps/api-server/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/api-server:${workspaceFolder}/kernel/backend:${workspaceFolder}/modules/hrms/backend:${workspaceFolder}/modules/crm/backend:${workspaceFolder}/plugins/api-logger/backend",
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": false
    },
    {
      "name": "Frontend: Chrome (web-app)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/web-app",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": [
        "Backend: FastAPI (api-server)",
        "Frontend: Chrome (web-app)"
      ]
    }
  ]
}

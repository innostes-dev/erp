{
  "name": "@innostes/ui",
  "version": "1.0.0",
  "description": "Accessible, high-performance React component library for enterprise admin interfaces, built on Base UI and styled with Tailwind CSS design tokens.",
  "license": "MIT",
  "author": "Northwind Traders Pvt Ltd <engineering@innostes.com>",
  "homepage": "https://innostes.com/ui/docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/innostes/erp.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/innostes/erp/issues"
  },
  "funding": {
    "type": "corporate",
    "url": "https://innostes.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@innostes/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./charts": {
      "@innostes/source": "./src/charts/index.ts",
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./editor": {
      "@innostes/source": "./src/editor/index.ts",
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "default": "./dist/editor/index.js"
    },
    "./tailwind.css": "./tailwind/tailwind.css",
    "./theme.css": "./tailwind/theme.css",
    "./dark.css": "./tailwind/dark.css",
    "./styles.css": "./dist/styles.css",
    "./api.json": "./dist/api.json"
  },
  "files": [
    "dist",
    "tailwind/tailwind.css",
    "tailwind/theme.css",
    "tailwind/dark.css",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "check:size": "node ./scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0",
    "tailwindcss": "^4.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "innostes",
    "design-system",
    "react",
    "tailwindcss",
    "base-ui",
    "admin",
    "dashboard",
    "components",
    "accessible",
    "ui",
    "rich-text",
    "charts"
  ],
  "nx": {
    "name": "ui"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  }
}

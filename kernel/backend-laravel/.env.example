# ---------------------------------------------------------------------------
# Innostes kernel API (Laravel). Copy to .env and adjust. All variables are optional in
# development; production (APP_ENV=production) refuses to start with insecure defaults.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Innostes ERP API"
APP_ENV=development            # "production" enables the secure-configuration check
APP_DEBUG=false
APP_VERSION=0.1.0
APP_KEY=                       # php artisan key:generate (only used by Laravel internals; tokens use JWT_SECRET_KEY)
APP_URL=http://localhost:8000
PORT=8000
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
TRUSTED_PROXIES=               # comma-separated proxy IPs/CIDRs, or * (so X-Forwarded-* and rate limits use the real client)

# --- Database (PostgreSQL; same schema as the FastAPI and NestJS kernels) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# DATABASE_URL=postgresql://user:pass@host:5432/erp   # alternative to the DB_* variables (SQLAlchemy "+asyncpg" suffix is accepted)

# --- First-run setup ---------------------------------------------------------
SETUP_ENABLED=true             # set false in production to disable the web wizard (404)
SETUP_TOKEN=                   # required X-Setup-Token; if empty one is generated into SETUP_TOKEN_FILE
# SETUP_TOKEN_FILE=storage/app/setup-token
SETUP_MAX_ATTEMPTS=10
SETUP_ATTEMPT_WINDOW_SECONDS=900

# --- JWT / sessions ------------------------------------------------------------
JWT_SECRET_KEY=insecure-dev-secret-key-change-in-production   # >= 32 chars, unique in production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
TEMP_PASSWORD_EXPIRE_HOURS=24
COOKIE_SECURE=false            # true behind HTTPS
COOKIE_SAMESITE=lax

# --- Account protection ------------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
RATE_LIMIT_AUTH_PER_MINUTE=60              # per client IP: login, refresh, forgot/reset password
RATE_LIMIT_LOGIN_PER_ACCOUNT_PER_MINUTE=10 # per client IP + email on /auth/login
RATE_LIMIT_API_PER_MINUTE=600              # per user (or IP) for everything else

# --- PII encryption (AES-256-GCM envelope + HMAC blind index) -----------------------
# JSON keyring {"<version>": "<64 hex chars | any string>"}; 32-byte keys. Must match the other backends on a shared DB.
ENCRYPTION_KEYS={"1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
ENCRYPTION_CURRENT_KEY_VERSION=1
BLIND_INDEX_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# --- Email (password reset). Without SMTP_HOST mails are only logged (never in production). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Innostes ERP <noreply@innostes.com>"
SMTP_USE_TLS=true

# --- Runtime -----------------------------------------------------------------------------
LOG_CHANNEL=json               # structured JSON lines on stderr
LOG_LEVEL=info
CACHE_STORE=file               # use redis for multi-instance rate limiting / setup throttling
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

  "info": {
    "title": "Innostes ERP API",
    "description": "Innostes ERP platform kernel API (NestJS implementation). Behaviourally identical to the FastAPI reference: authentication, first-run setup, tenancy and user management.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "General",
      "description": "Service identity, runtime metadata, and public configuration."
    },
    {
      "name": "Observability",
      "description": "Health probes and diagnostics."
    },
    {
      "name": "Authentication",
      "description": ""
    },
    {
      "name": "Setup",
      "description": ""
    },
    {
      "name": "Tenancy",
      "description": ""
    },
    {
      "name": "User management",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "JWT Bearer access token or personal access token (inno_live_...)."
      },
      "SetupToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Setup-Token",
        "description": "One-time system installation token (SETUP_TOKEN)."
      }
    },
    "schemas": {
      "TenantCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "country": {
            "type": "string",
            "nullable": true,
            "minLength": 2,
            "maxLength": 2
          },
          "timezone": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "language": {
            "type": "string",
            "nullable": true,
            "maxLength": 16
          },
          "date_format": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "AdminUserCreate": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "last_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "maxLength": 32
          }
        },
        "required": [
          "first_name",
          "email",
          "password"
        ]
      },
      "SetupBrandingCreate": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "maxLength": 32
          },
          "primary_color": {
            "type": "string",
            "maxLength": 32
          },
          "logo_url": {
            "type": "string",
            "nullable": true,
            "maxLength": 2048
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "properties": {
          "organization": {
            "$ref": "#/components/schemas/TenantCreate"
          },
          "admin": {
            "$ref": "#/components/schemas/AdminUserCreate"
          },
          "branding": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SetupBrandingCreate"
              }
            ]
          }
        },
        "required": [
          "organization",
          "admin"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "device_fingerprint": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "device_name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "device_type": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile",
              "tablet",
              "scanner",
              "kiosk"
            ]

{
  "name": "kernel-backend-nestjs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "kernel/backend-nestjs/src",
  "tags": ["scope:kernel", "backend:nestjs"],
  "targets": {
    "install": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm ci" } },
    "build": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm run build" } },
    "serve": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm run start:dev" } },
    "migrate": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm run migrate" } },
    "openapi": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm run openapi" } },
    "lint": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm run lint" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm run typecheck" } },
    "test": { "executor": "nx:run-commands", "options": { "cwd": "kernel/backend-nestjs", "command": "npm test && npm run test:e2e" } }
  }
}

# Innostes kernel API (NestJS) - environment configuration.
# Copy to .env (or inject via your orchestrator). Variable names match the FastAPI/Laravel kernels so one
# environment file can be shared. Secrets below are placeholders: generate your own for any non-local use.

# ---- Application ------------------------------------------------------------
APP_NAME=Innostes ERP API
APP_VERSION=0.1.0
# development | test | production. In production the server REFUSES to start with insecure defaults.
APP_ENV=development
PORT=8001
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent  (logs are structured JSON on stdout)
LOG_LEVEL=info
# Comma separated browser origins allowed to call the API (credentials are enabled, so never "*").
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Express "trust proxy": false | true | <hop count> | <subnet list>. Set when behind a reverse proxy/load balancer
# so rate limiting and setup-token throttling see the real client IP.
TRUST_PROXY=false
# Cookie "Secure" flag. Defaults to true when APP_ENV=production, otherwise false.
# COOKIE_SECURE=true
# Create the schema at startup when it does not exist (no-op if the tables already exist). `npm run migrate` does the same.
AUTO_MIGRATE=false
# Hard limit (ms) for draining requests on SIGTERM/SIGINT before the process exits.
SHUTDOWN_TIMEOUT_MS=10000
# Prometheus text metrics at GET /metrics (disabled by default); optionally require "Authorization: Bearer <token>".
METRICS_ENABLED=false
# METRICS_TOKEN=

# ---- Database (PostgreSQL 14+) ---------------------------------------------
# Either a single URL ...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innostes
# ... or discrete settings (used when DATABASE_URL / DB_URI / DB_URL is empty)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=innostes
# disable | allow | prefer | require | verify-ca | verify-full  (discrete settings only; put sslmode in the URL otherwise)
# DB_SSL_MODE=prefer
DB_POOL_SIZE=10
# Seconds to wait for a pooled connection
DB_POOL_TIMEOUT=30

# ---- First-run setup --------------------------------------------------------
# Allow the web setup wizard (/setup). Set to false after installation (or in production images that use the CLI path).
SETUP_ENABLED=true
# One-time token required in the X-Setup-Token header. If unset, a random token is generated into SETUP_TOKEN_FILE
# and printed in the server log at startup. REQUIRED in production while SETUP_ENABLED=true.
# Leave empty in development (a random token is generated). In production set a random value of >= 16 chars
# (e.g. `openssl rand -base64 32`); documented placeholders and short values are rejected at boot.
SETUP_TOKEN=
SETUP_TOKEN_FILE=var/setup-token

# ---- Tokens & account security ---------------------------------------------
# HS256 signing secret, >= 32 chars. Must be set in production; must match the other backends sharing the database.
JWT_SECRET_KEY=insecure-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
TEMP_PASSWORD_EXPIRE_HOURS=24
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
# Base URL of the web-app (used in password-reset links)
FRONTEND_URL=http://localhost:4200

# ---- PII encryption (AES-256-GCM envelope) & blind index --------------------
# JSON keyring {"<version>": "<64 hex chars = 32 bytes>"}; other strings are UTF-8 padded/truncated to 32 bytes.
# Keys must be identical across backends sharing a database. Generate: openssl rand -hex 32
ENCRYPTION_KEYS={"1":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
ENCRYPTION_CURRENT_KEY_VERSION=1
# HMAC-SHA256 pepper for the email/mobile blind indexes (>= 32 chars in production). NEVER change after data exists.
BLIND_INDEX_PEPPER=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ---- Email (password reset). Without SMTP_HOST mails are only logged in development ----
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM=Innostes ERP <noreply@innostes.com>
SMTP_USE_TLS=true

# ---- Rate limits (requests per minute per client IP and route) -------------
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=60
RATE_LIMIT_REFRESH_PER_MINUTE=60
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=10
RATE_LIMIT_SETUP_PER_MINUTE=30

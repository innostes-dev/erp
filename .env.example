# ==========================================
# Innostes ERP Configuration
# ==========================================

# Application Settings
PORT=8001
APP_NAME="Innostes ERP API"
APP_ENV=development
APP_DEBUG=true
AUTO_MIGRATE=true
# Browser origins allowed to call the API (web-app URL), comma-separated
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# First-run setup (see docs: Architecture > First-run Setup)
# Allow the web setup wizard. Set false in production; install with: python -m kernel.setup install
SETUP_ENABLED=true
# One-time token for the web wizard. Leave empty to have one generated and printed in the server log.
SETUP_TOKEN=
# Organisation for: python -m kernel.setup install --from-env
# SETUP_ORG_NAME=Acme Corporation
# SETUP_ORG_SLUG=acme
# SETUP_ORG_COUNTRY=IN
# SETUP_ORG_TIMEZONE=Asia/Kolkata
# SETUP_ORG_LANGUAGE=en-IN
# SETUP_ORG_DATE_FORMAT=DD/MM/YYYY

# Security & JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enterprise PostgreSQL Configuration
# Option A: Full Connection URI (takes precedence if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_dev

# Option B: Individual connection parameters (fallback if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_dev
DB_SCHEMA=public
DB_SSL_MODE=prefer

# Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO_SQL=false

# Innostes OS — Environment Variables Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innostes_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=innostes_db

# Security & Auth
JWT_SECRET=innostes-os-kernel-auth-secret-key-2026

# Migration & Seeding Controls
# Set AUTO_MIGRATE=true to auto-apply module migrations on boot during development
# Set AUTO_MIGRATE=false in production for pre-deploy CI/CD migrations
AUTO_MIGRATE=true
AUTO_SEED=true
